# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Moodle (docker compose reads these)
MOODLE_SITE_URL=http://localhost:8080
MOODLE_ADMIN_PASSWORD=

# Agent -> Moodle. Leave MOODLE_TOKEN blank to use mock data.
MOODLE_URL=http://localhost:8080
MOODLE_TOKEN=

# Test student (created by moodle/seed_sample_course.php)
MOODLE_STUDENT_USERNAME=student1
MOODLE_STUDENT_PASSWORD=
